{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchReference Schema",
  "type": "object",
  "required": ["referenceId", "sourceName", "sourceURL", "accessDate", "claimSupported", "verificationDate", "status"],
  "type": "object",
  "properties": {
    "referenceId": {
      "type": "string",
      "pattern": "^REF-\\d{3}$",
      "description": "Unique reference identifier in format REF-XXX"
    },
    "sourceName": {
      "type": "string",
      "minLength": 3,
      "description": "Name of the source publication or organisation"
    },
    "sourceURL": {
      "type": "string",
      "format": "uri",
      "description": "Direct URL to the source material"
    },
    "accessDate": {
      "type": "string",
      "format": "date",
      "description": "When the source was accessed"
    },
    "claimSupported": {
      "type": "string",
      "description": "Which specific claim this source validates"
    },
    "verificationDate": {
      "type": "string",
      "format": "date",
      "description": "When the claim was last verified"
    },
    "status": {
      "type": "string",
      "enum": ["verified", "pending", "disputed"],
      "description": "Verification status of the claim"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the source or claim"
    }
  },
  "additionalProperties": false
}